{% set currentLang = lang or 'ar' %}{% set tr = i18n[currentLang] %}{% set categorySlug = category.slug_en if currentLang == 'en' else category.slug %}{% set categoryProducts = products | inCategory(category.id) %}{% set categoryName = category.name_en if currentLang == 'en' else category.name_ar %}
<a href="{{ ('/categories/' + categorySlug + '/') | localeUrl(currentLang) | url }}" class="category-home-box"><div class="category-home-img-wrap"><img src="{{ (category.image or '/assets/images/categories/default-category.webp') | url }}" alt="{{ categoryName }} {{ tr.fromNestica }}" class="category-home-img" width="{{ category.image_width or 900 }}" height="{{ category.image_height or 650 }}" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='{{ '/assets/images/categories/default-category.webp' | url }}';"></div><div class="category-home-content"><h3>{{ categoryName }}</h3><p>{{ categoryProducts.length }} {{ tr.productCount }}</p></div></a>
