{% set currentLang = lang or 'ar' %}{% set tr = i18n[currentLang] %}
{% set productName = product.name_en if currentLang == 'en' else product.name %}
{% set productCategory = product.category_name_en if currentLang == 'en' else (product.category_name or product.category) %}
{% set productMaterial = product.material_en if currentLang == 'en' else product.material %}
{% set productDesc = product.card_description_en if currentLang == 'en' else product.card_description %}
{% set productSlug = product.slug_en if currentLang == 'en' else product.slug %}
{% set categorySlug = product.category_slug_en if currentLang == 'en' else product.category_slug %}
<article class="product-card card h-100 border-0" data-product-card data-name="{{ productName | lower }}" data-category="{{ productCategory }}" data-category-id="{{ product.category_id or '' }}" data-price="{{ product.price or 0 }}" data-spaces="{{ product.spaces | join(',') }}" data-ready="{% if product.is_ready %}true{% else %}false{% endif %}" data-delivery="{% if product.has_real_delivery %}true{% else %}false{% endif %}">
  <a href="{{ ('/products/' + productSlug + '/') | localeUrl(currentLang) | url }}" class="product-image-link" aria-label="{{ tr.details }}: {{ productName }}">
    <div class="product-badges">{% if product.is_offer and product.old_price %}<span class="catalog-badge badge-offer">{{ tr.offer }}</span>{% endif %}{% if product.has_real_delivery %}<span class="catalog-badge badge-real"><i class="bi bi-camera"></i> {{ tr.real }}</span>{% endif %}{% if product.is_ready %}<span class="catalog-badge badge-ready">{{ tr.ready }}</span>{% endif %}</div>
    <img src="{{ (product.main_image or '/assets/images/products/default-product.webp') | url }}"  {% if product.image_variants %}srcset="{% for variant in product.image_variants %}{{ variant.src | url }} {{ variant.width }}w{% if not loop.last %}, {% endif %}{% endfor %}" sizes="(min-width: 1200px) 300px, (min-width: 768px) 45vw, 95vw"{% endif %} class="card-img-top product-card-img" alt="{{ productName }} {{ tr.fromNestica }} - {{ productCategory or tr.productFallback }}" width="{{ product.main_image_width or 900 }}" height="{{ product.main_image_height or 900 }}" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='{{ '/assets/images/products/default-product.webp' | url }}';">
  </a>
  <div class="card-body d-flex flex-column">
    <div class="product-meta-line"><a href="{{ ('/categories/' + categorySlug + '/') | localeUrl(currentLang) | url }}">{{ productCategory }}</a>{% if productMaterial %}<span>{{ productMaterial }}</span>{% endif %}</div>
    <h3 class="product-title"><a href="{{ ('/products/' + productSlug + '/') | localeUrl(currentLang) | url }}">{{ productName }}</a></h3>
    {% if productDesc %}<p class="product-short-desc">{{ productDesc }}</p>{% endif %}
    <div class="product-card-price">{% if product.is_offer and product.old_price %}<span class="new-price">{{ product.price | egp }}</span><span class="old-price">{{ product.old_price | egp }}</span>{% else %}<span class="normal-price">{{ product.price | egp }}</span>{% endif %}</div>
    <div class="product-card-actions mt-auto">
      <a href="{{ ('/products/' + productSlug + '/') | localeUrl(currentLang) | url }}" class="btn btn-dark rounded-pill">{{ tr.details }}</a>
      <a class="btn btn-outline-success rounded-pill" href="https://wa.me/{{ settings.whatsapp | replace('+','') }}?text={{ ((tr.askAbout + ' ' + productName + ' - ' + settings.siteUrl + (('/products/' + productSlug + '/') | localeUrl(currentLang)))) | urlencode }}" target="_blank" rel="noopener" onclick="trackWhatsappLead('product_card_whatsapp')" aria-label="{{ tr.askAbout }} {{ productName }}"><i class="bi bi-whatsapp"></i></a>
      <button class="btn btn-outline-dark rounded-circle add-cart-icon" type="button" aria-label="{{ tr.addCart }}: {{ productName }}" onclick='addToCart({ id: "{{ product.id }}", name: {{ productName | json | safe }}, name_ar: {{ product.name | json | safe }}, name_en: {{ product.name_en | json | safe }}, price: {{ product.price or 0 }}, image: "{{ product.main_image }}", slug: "{{ productSlug }}", slug_ar: "{{ product.slug }}", slug_en: "{{ product.slug_en }}" })'><i class="bi bi-bag-plus"></i></button>
    </div>
  </div>
</article>
