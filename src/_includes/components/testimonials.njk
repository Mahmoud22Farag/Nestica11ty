{% set currentLang = lang or 'ar' %}{% if testimonials and testimonials.length %}
<section class="container section-space testimonials-section"{% if not testimonialsOnPage %} aria-labelledby="testimonialsTitle"{% endif %}>
  {% if not testimonialsOnPage %}<div class="section-heading text-center">
    <span class="section-kicker">{{ 'Customer Reviews' if currentLang == 'en' else 'آراء عملائنا' }}</span>
    <h2 id="testimonialsTitle">{{ 'What our customers told us after delivery' if currentLang == 'en' else 'قالوا إيه بعد ما الطقم وصلهم' }}</h2>
    <p>{{ 'Real messages our customers sent us on WhatsApp after receiving their order.' if currentLang == 'en' else 'رسائل حقيقية بعتها لنا عملاء نستيكا على واتساب بعد الاستلام.' }}</p>
  </div>{% endif %}
  <div class="testimonials-track{% if testimonialsOnPage %} testimonials-page-grid{% endif %}">
    {% for item in testimonials %}
    <figure class="testimonial-card">
      {% if item.image %}<div class="testimonial-shot"><img src="{{ item.image | url }}" alt="{{ 'WhatsApp message from a Nestica customer' if currentLang == 'en' else 'رسالة واتساب من عميل نستيكا' }}" width="{{ item.image_width }}" height="{{ item.image_height }}" loading="lazy" decoding="async"></div>{% else %}<i class="bi bi-quote" aria-hidden="true"></i>{% endif %}
      <blockquote class="{% if item.image and (currentLang != 'en' or item.lang == 'en') %}visually-hidden{% elif item.image %}testimonial-translation{% endif %}"{% if item.lang == 'en' %} lang="en" dir="ltr"{% endif %}>{{ item.quote_en if currentLang == 'en' else item.quote_ar }}</blockquote>
      <figcaption><i class="bi bi-whatsapp" aria-hidden="true"></i> {{ 'Nestica customer' if currentLang == 'en' else 'عميل نستيكا' }} · {{ item.context_en if currentLang == 'en' else item.context_ar }}</figcaption>
    </figure>
    {% endfor %}
  </div>
  {% if not testimonialsOnPage %}<div class="text-center mt-4"><a class="btn btn-outline-dark rounded-pill" href="{{ '/reviews/' | localeUrl(currentLang) | url }}">{{ 'All customer reviews' if currentLang == 'en' else 'كل آراء العملاء' }}</a></div>{% endif %}
</section>
{% endif %}
