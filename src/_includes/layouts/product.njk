---
layout: layouts/base.njk
---
{% set currentLang = lang or 'ar' %}{% set tr = i18n[currentLang] %}
{% set relatedProducts = products | relatedProducts(product) %}
{% set exactDeliveries = deliveries | deliveriesForProduct(product.id) %}
{% set categoryDeliveries = deliveries | deliveriesInCategory(product.category_id) %}
{% set relatedDeliveries = exactDeliveries if exactDeliveries.length else categoryDeliveries %}
{% set productName = product.name_en if currentLang == 'en' else product.name %}
{% set productCategory = product.category_name_en if currentLang == 'en' else product.category_name %}
{% set productMaterial = product.material_en if currentLang == 'en' else product.material %}
{% set productDescription = product.description_en if currentLang == 'en' else (product.description_ar or product.description) %}
{% set productShort = product.card_description_en if currentLang == 'en' else product.card_description %}
{% set productSlug = product.slug_en if currentLang == 'en' else product.slug %}
{% set categorySlug = product.category_slug_en if currentLang == 'en' else product.category_slug %}
{% set productPath = ('/products/' ~ productSlug ~ '/') | localeUrl(currentLang) %}
{% set whatsappMessage = tr.askAbout ~ ' ' ~ productName ~ ' - ' ~ ('Base price ' if currentLang == 'en' else 'السعر الأساسي ') ~ (product.price or 0) ~ ' EGP - ' ~ settings.siteUrl ~ productPath %}

<nav aria-label="{{ 'Breadcrumb' if currentLang == 'en' else 'مسار الصفحة' }}" class="container breadcrumb-wrap"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="{{ '/' | localeUrl(currentLang) | url }}">{{ tr.home }}</a></li><li class="breadcrumb-item"><a href="{{ '/products/' | localeUrl(currentLang) | url }}">{{ tr.products }}</a></li><li class="breadcrumb-item"><a href="{{ ('/categories/' + categorySlug + '/') | localeUrl(currentLang) | url }}">{{ productCategory }}</a></li><li class="breadcrumb-item active" aria-current="page">{{ productName }}</li></ol></nav>

<section class="container product-page-section">
  <div class="row g-5 align-items-start">
    <div class="col-lg-6">
      <div class="product-main-wrap">{% if product.is_offer and product.old_price %}<span class="product-page-offer">{{ tr.offer }}</span>{% endif %}<img id="mainProductImage" src="{{ (product.main_image or '/assets/images/products/default-product.webp') | url }}" alt="{{ productName }} {{ tr.fromNestica }} - {{ productCategory }}"  {% if product.image_variants %}srcset="{% for variant in product.image_variants %}{{ variant.src | url }} {{ variant.width }}w{% if not loop.last %}, {% endif %}{% endfor %}" sizes="(min-width: 1200px) 650px, (min-width: 768px) 45vw, 95vw"{% endif %} class="img-fluid w-100" width="{{ product.main_image_width or 1000 }}" height="{{ product.main_image_height or 1000 }}" loading="eager" fetchpriority="high" decoding="async" onerror="this.onerror=null;this.src='{{ '/assets/images/products/default-product.webp' | url }}';"></div>
      {% if product.gallery and product.gallery.length > 1 %}<div class="product-thumbs" aria-label="{{ 'Additional product images' if currentLang == 'en' else 'صور إضافية للمنتج' }}">{% for img in product.gallery %}<button type="button" class="product-thumb-btn {% if loop.first %}active{% endif %}" onclick="changeMainImage('{{ img | url }}', this)" aria-label="{{ 'View image' if currentLang == 'en' else 'عرض صورة' }} {{ loop.index }}"><img src="{{ img | url }}" alt="{{ 'Image' if currentLang == 'en' else 'صورة' }} {{ loop.index }} - {{ productName }}" width="120" height="120" loading="lazy" decoding="async"></button>{% endfor %}</div>{% endif %}
    </div>

    <div class="col-lg-6 product-info-column">
      <div class="product-category-link"><a href="{{ ('/categories/' + categorySlug + '/') | localeUrl(currentLang) | url }}">{{ productCategory }}</a><span>SKU: {{ product.sku }}</span></div>
      <h1>{{ productName }}</h1>{% if productShort %}<p class="product-page-short-desc">{{ productShort }}</p>{% endif %}
      <div class="product-page-price">{% if product.is_offer and product.old_price %}<span class="new-price">{{ product.price | egp }}</span><span class="old-price">{{ product.old_price | egp }}</span>{% else %}<span class="main-price">{{ product.price | egp }}</span>{% endif %}<small>{{ 'Base price before customization or delivery' if currentLang == 'en' else 'السعر الأساسي قبل أي تعديلات أو توصيل' }}</small></div>

      <div class="product-facts">
        <div><i class="bi bi-layers"></i><span><small>{{ 'Material' if currentLang == 'en' else 'الخامة' }}</small>{{ productMaterial }}</span></div>
        <div><i class="bi bi-grid"></i><span><small>{{ 'Category' if currentLang == 'en' else 'القسم' }}</small>{{ productCategory }}</span></div>
        <div><i class="bi bi-check-circle"></i><span><small>{{ 'Status' if currentLang == 'en' else 'الحالة' }}</small>{{ 'Available for inquiry' if currentLang == 'en' else 'متاح للاستفسار' }}</span></div>
      </div>

      <div class="space-tags"><strong>{{ 'Initially suitable for:' if currentLang == 'en' else 'مناسب مبدئيًا لـ:' }}</strong>{% for space in spaces %}{% if space.slug in product.spaces %}<a href="{{ ('/spaces/' + space.slug + '/') | localeUrl(currentLang) | url }}">{{ space.name_en if currentLang == 'en' else space.name_ar }}</a>{% endif %}{% endfor %}</div>

      <div class="product-order-box"><div class="row g-3">
        <div class="col-sm-4"><label for="quantity" class="form-label">{{ 'Quantity' if currentLang == 'en' else 'الكمية' }}</label><input id="quantity" type="number" min="1" value="1" class="form-control"></div>
        <div class="col-sm-8"><label class="form-label">{{ 'Request type' if currentLang == 'en' else 'نوع الطلب' }}</label><div class="request-type-options"><label><input type="radio" name="requestType" id="requestTypeSame" value="same" checked onchange="toggleNotes()"> {{ 'Same product' if currentLang == 'en' else 'نفس المنتج' }}</label><label><input type="radio" name="requestType" id="requestTypeCustom" value="custom" onchange="toggleNotes()"> {{ 'Custom request' if currentLang == 'en' else 'تعديل خاص' }}</label></div></div>
        <div class="col-12" id="notesBox" hidden><label for="notes" class="form-label">{{ 'Add dimensions, color or notes' if currentLang == 'en' else 'اكتب المقاس أو اللون أو ملاحظاتك' }}</label><textarea id="notes" class="form-control" rows="3" placeholder="{{ 'Example: Beige color for a 3 × 4 m space' if currentLang == 'en' else 'مثال: محتاج لون بيج ومقاس مناسب لمساحة 3×4 متر' }}"></textarea></div>
      </div><div class="product-action-row"><button type="button" class="btn btn-dark rounded-pill" onclick='addProductDetailsToCart({id:"{{ product.id }}",name:{{ productName | json | safe }},name_ar:{{ product.name | json | safe }},name_en:{{ product.name_en | json | safe }},price:{{ product.price or 0 }},image:"{{ product.main_image }}",slug:"{{ productSlug }}",slug_ar:"{{ product.slug }}",slug_en:"{{ product.slug_en }}"})'><i class="bi bi-bag-plus"></i> {{ tr.addCart }}</button><a class="btn btn-success rounded-pill" href="https://wa.me/{{ settings.whatsapp | replace('+','') }}?text={{ whatsappMessage | urlencode }}" target="_blank" rel="noopener" onclick="trackWhatsappLead('product_direct_whatsapp')"><i class="bi bi-whatsapp"></i> {{ tr.whatsappAsk }}</a></div></div>

      <div class="product-trust-box">
        <div><i class="bi bi-rulers"></i><span><strong>{{ 'Model-specific customization' if currentLang == 'en' else 'تخصيص حسب الموديل' }}</strong>{{ 'Ask about available dimensions and colors.' if currentLang == 'en' else 'اسأل عن المقاسات والألوان المتاحة.' }}</span></div>
        <div><i class="bi bi-image"></i><span><strong>{{ 'Send a space photo' if currentLang == 'en' else 'ابعت صورة المكان' }}</strong>{{ 'It helps us compare scale and layout.' if currentLang == 'en' else 'علشان نساعدك تقارن الحجم والتوزيع.' }}</span></div>
        <div><i class="bi bi-chat-dots"></i><span><strong>{{ 'Confirm before production' if currentLang == 'en' else 'تأكيد قبل التنفيذ' }}</strong>{{ 'Availability, changes and delivery are confirmed on WhatsApp.' if currentLang == 'en' else 'التوفر والتعديلات والتوصيل تتأكد على واتساب.' }}</span></div>
      </div>
    </div>
  </div>
</section>

<section class="container section-space product-details-grid"><div class="row g-4"><div class="col-lg-7"><div class="product-desc-card"><span class="section-kicker">{{ 'Product Details' if currentLang == 'en' else 'تفاصيل المنتج' }}</span><h2>{{ 'Description and Specifications' if currentLang == 'en' else 'الوصف والمواصفات' }}</h2><div class="desc-content">{{ (productDescription or '') | replace('\n','<br>') | safe }}</div></div></div><div class="col-lg-5"><div class="product-desc-card"><span class="section-kicker">{{ 'Quick Summary' if currentLang == 'en' else 'ملخص سريع' }}</span><h2>{{ 'Product Information' if currentLang == 'en' else 'بيانات المنتج' }}</h2><div class="specs-table">
<div class="spec-row"><div class="spec-label">{{ 'Name' if currentLang == 'en' else 'الاسم' }}</div><div class="spec-value">{{ productName }}</div></div>
<div class="spec-row"><div class="spec-label">{{ 'Base Price' if currentLang == 'en' else 'السعر الأساسي' }}</div><div class="spec-value">{{ product.price | egp }}</div></div>
<div class="spec-row"><div class="spec-label">{{ 'Category' if currentLang == 'en' else 'القسم' }}</div><div class="spec-value"><a href="{{ ('/categories/' + categorySlug + '/') | localeUrl(currentLang) | url }}">{{ productCategory }}</a></div></div>
<div class="spec-row"><div class="spec-label">{{ 'Material' if currentLang == 'en' else 'الخامة' }}</div><div class="spec-value">{{ productMaterial }}</div></div>
<div class="spec-row"><div class="spec-label">{{ 'Product Code' if currentLang == 'en' else 'كود المنتج' }}</div><div class="spec-value">{{ product.sku }}</div></div>
</div></div></div></div></section>

{% if relatedDeliveries.length %}<section class="product-real-section section-space"><div class="container"><div class="section-heading d-flex flex-wrap justify-content-between align-items-end gap-3"><div><span class="section-kicker">{{ ('This Product in a Real Space' if exactDeliveries.length else 'From the Same Category') if currentLang == 'en' else ('نفس المنتج على الطبيعة' if exactDeliveries.length else 'من نفس الفئة') }}</span><h2>{{ 'Real deliveries to help you visualize the result' if currentLang == 'en' else 'تنفيذات على الطبيعة تساعدك تتخيل النتيجة' }}</h2><p>{{ ('These photos show the same product in a real Nestica delivery.' if exactDeliveries.length else 'These are deliveries from the same material or category and may not be the exact same model.') if currentLang == 'en' else ('الصور التالية لنفس المنتج داخل تسليم فعلي من نستيكا.' if exactDeliveries.length else 'الصور التالية لتنفيذات من نفس نوع الخامة أو القسم، وليست بالضرورة لنفس الموديل.') }}</p></div><a href="{{ '/real-deliveries/' | localeUrl(currentLang) | url }}" class="btn btn-outline-dark rounded-pill">{{ tr.realDeliveries }}</a></div><div class="row g-4">{% for delivery in relatedDeliveries | limit(3) %}<div class="col-md-4"><a class="delivery-preview-card" href="{{ '/real-deliveries/' | localeUrl(currentLang) | url }}#delivery-{{ delivery.id }}"><img src="{{ delivery.image | url }}" alt="{{ delivery.alt_en if currentLang == 'en' else delivery.alt_ar }}" width="{{ delivery.image_width }}" height="{{ delivery.image_height }}" loading="lazy"><div class="delivery-preview-overlay"><span>{{ delivery.space_name_en if currentLang == 'en' else delivery.space_name }}</span><h3>{{ delivery.title_en if currentLang == 'en' else delivery.title_ar }}</h3></div></a></div>{% endfor %}</div></div></section>{% endif %}

{% if relatedProducts.length %}<section class="container section-space"><div class="section-heading d-flex flex-wrap justify-content-between align-items-end gap-3"><div><span class="section-kicker">{{ 'Similar Products' if currentLang == 'en' else 'منتجات مشابهة' }}</span><h2>{{ 'More choices from' if currentLang == 'en' else 'اختيارات أخرى من' }} {{ productCategory }}</h2></div><a href="{{ ('/categories/' + categorySlug + '/') | localeUrl(currentLang) | url }}" class="btn btn-outline-dark rounded-pill">{{ 'View Category' if currentLang == 'en' else 'كل القسم' }}</a></div><div class="row g-4">{% for product in relatedProducts | limit(4) %}<div class="col-xl-3 col-md-6">{% include "components/product-card.njk" %}</div>{% endfor %}</div></section>{% endif %}

<script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Product","@id":"{{ settings.siteUrl }}{{ ('/products/' + productSlug + '/') | localeUrl(currentLang) }}/#product","name":"{{ productName | jsonLdSafe }}","sku":"{{ product.sku }}","description":"{{ productDescription | seoDesc(productName) | jsonLdSafe }}","image":[{% for img in product.gallery %}"{{ settings.siteUrl }}{{ img }}"{% if not loop.last %},{% endif %}{% endfor %}],"brand":{"@type":"Brand","name":"{{ settings.brand }}"},"category":"{{ productCategory | jsonLdSafe }}","material":"{{ productMaterial | jsonLdSafe }}","offers":{"@type":"Offer","url":"{{ settings.siteUrl }}{{ ('/products/' + productSlug + '/') | localeUrl(currentLang) }}","priceCurrency":"EGP","price":"{{ product.price or 0 }}",{% if product.is_ready %}"availability":"https://schema.org/InStock",{% elif product.availability %}"availability":"https://schema.org/{{ product.availability }}",{% endif %}"itemCondition":"https://schema.org/NewCondition","seller":{"@id":"{{ settings.siteUrl }}/#organization"}}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"{{ tr.home }}","item":"{{ settings.siteUrl }}{{ '/' | localeUrl(currentLang) }}"},{"@type":"ListItem","position":2,"name":"{{ tr.products }}","item":"{{ settings.siteUrl }}{{ '/products/' | localeUrl(currentLang) }}"},{"@type":"ListItem","position":3,"name":"{{ productCategory | jsonLdSafe }}","item":"{{ settings.siteUrl }}{{ ('/categories/' + categorySlug + '/') | localeUrl(currentLang) }}"},{"@type":"ListItem","position":4,"name":"{{ productName | jsonLdSafe }}","item":"{{ settings.siteUrl }}{{ ('/products/' + productSlug + '/') | localeUrl(currentLang) }}"}]}]}</script>
<script>window.nesticaProductMeta={id:"{{ product.id }}",name:{{ productName | json | safe }},price:{{ product.price or 0 }},category:{{ productCategory | json | safe }}};</script>
