---
pagination:
  data: categories
  size: 1
  alias: category
permalink: "/en/categories/{{ category.slug_en }}/"
layout: layouts/base.njk
lang: en
eleventyComputed:
  title: "{{ category.seo_title_en }}"
  description: "{{ category.meta_description_en }}"
  image: "{{ category.image }}"
  alternateArPath: "/categories/{{ category.slug }}/"
---
{% set categoryProducts = products | inCategory(category.id) %}
<nav aria-label="Breadcrumb" class="container breadcrumb-wrap"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="{{ '/en/' | url }}">Home</a></li><li class="breadcrumb-item"><a href="{{ '/en/products/' | url }}">Products</a></li><li class="breadcrumb-item active" aria-current="page">{{ category.name_en }}</li></ol></nav>
<section class="category-hero"><div class="container"><div class="row align-items-center g-5"><div class="col-lg-7"><span class="section-kicker">{{ category.name_en }}</span><h1>{{ category.name_en }}</h1><p>{{ category.intro_en }}</p><div class="category-hero-actions"><a href="#category-products" class="btn btn-dark rounded-pill">View {{ categoryProducts.length }} Products</a><a href="https://wa.me/{{ settings.whatsapp | replace('+','') }}?text={{ ('I need help choosing ' + category.name_en) | urlencode }}" target="_blank" rel="noopener" class="btn btn-outline-success rounded-pill" onclick="trackWhatsappLead('category_help_en')"><i class="bi bi-whatsapp"></i> Ask for a Recommendation</a></div></div><div class="col-lg-5"><img class="category-hero-img" src="{{ category.image | url }}" alt="{{ category.name_en }} in Egypt by Nestica" width="{{ category.image_width }}" height="{{ category.image_height }}" loading="eager" fetchpriority="high" decoding="async"></div></div></div></section>
{% if category.highlights_en.length %}<section class="category-highlights"><div class="container"><div class="row g-3">{% for item in category.highlights_en %}<div class="col-md"><div><i class="bi bi-check2-circle"></i><span>{{ item }}</span></div></div>{% endfor %}</div></div></section>{% endif %}
<section class="container section-space" id="category-products"><div class="section-heading d-flex flex-wrap justify-content-between align-items-end gap-3"><div><span class="section-kicker">Available Models</span><h2>{{ category.name_en }}</h2><p>Review product photos, specifications and base price.</p></div><div class="category-search"><i class="bi bi-search"></i><input type="search" id="productSearchInput" class="form-control" placeholder="Search within this category..."></div></div><div class="row g-4" id="productsGrid">{% for product in categoryProducts %}<div class="col-xl-3 col-lg-4 col-md-6 product-list-item">{% include "components/product-card.njk" %}</div>{% endfor %}</div><div class="empty-products d-none" id="noProductsFound"><h2>No Matching Results</h2><p>Try a different search term.</p></div></section>
<section class="category-guide section-space"><div class="container"><div class="row g-5 align-items-start"><div class="col-lg-5"><span class="section-kicker">Buying Guide</span><h2>{{ category.guide_title_en }}</h2><p>{{ category.intro_en }}</p><a href="{{ '/en/guides/' | url }}" class="btn btn-outline-dark rounded-pill">Read Nestica Guides</a></div><div class="col-lg-7"><div class="guide-points">{% for paragraph in category.guide_paragraphs_en %}<div><span>{{ loop.index }}</span><p>{{ paragraph }}</p></div>{% endfor %}</div></div></div></div></section>
{% if category.faqs_en.length %}<section class="container section-space faq-section"><div class="section-heading text-center"><span class="section-kicker">FAQ</span><h2>Questions About {{ category.name_en }}</h2></div><div class="accordion faq-accordion" id="categoryFaqEn">{% for faq in category.faqs_en %}<div class="accordion-item"><h3 class="accordion-header"><button class="accordion-button {% if not loop.first %}collapsed{% endif %}" type="button" data-bs-toggle="collapse" data-bs-target="#cat-faq-en-{{ loop.index }}">{{ faq.q }}</button></h3><div id="cat-faq-en-{{ loop.index }}" class="accordion-collapse collapse {% if loop.first %}show{% endif %}" data-bs-parent="#categoryFaqEn"><div class="accordion-body">{{ faq.a }}</div></div></div>{% endfor %}</div></section>{% endif %}
<script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"{{ settings.siteUrl }}/en/"},{"@type":"ListItem","position":2,"name":"Products","item":"{{ settings.siteUrl }}/en/products/"},{"@type":"ListItem","position":3,"name":"{{ category.name_en | jsonLdSafe }}","item":"{{ settings.siteUrl }}/en/categories/{{ category.slug_en }}/"}]},{"@type":"ItemList","name":"{{ category.name_en | jsonLdSafe }}","numberOfItems":{{ categoryProducts.length }},"itemListElement":[{% for product in categoryProducts %}{"@type":"ListItem","position":{{ loop.index }},"url":"{{ settings.siteUrl }}/en/products/{{ product.slug_en }}/","name":"{{ product.name_en | jsonLdSafe }}"}{% if not loop.last %},{% endif %}{% endfor %}]}{% if category.faqs_en.length %},
{"@type":"FAQPage","mainEntity":[{% for faq in category.faqs_en %}{"@type":"Question","name":"{{ faq.q | jsonLdSafe }}","acceptedAnswer":{"@type":"Answer","text":"{{ faq.a | jsonLdSafe }}"}}{% if not loop.last %},{% endif %}{% endfor %}]}{% endif %}
]}</script>
