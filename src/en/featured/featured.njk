---
pagination:
  data: featuredCollections
  size: 1
  alias: collection
permalink: "/en/featured/{{ collection.slug }}/"
layout: layouts/base.njk
lang: en
eleventyComputed:
  title: "{{ collection.name_en }}"
  description: "{{ collection.description_en }}"
---
{% set filteredProducts = products | collectionProducts(collection.slug) %}<section class="catalog-hero compact-hero"><div class="container text-center"><span class="section-kicker">Featured Collection</span><h1>{{ collection.name_en }}</h1><p>{{ collection.description_en }}</p></div></section><section class="container section-space">{% if filteredProducts.length %}<div class="row g-4">{% for product in filteredProducts %}<div class="col-xl-3 col-lg-4 col-md-6">{% include "components/product-card.njk" %}</div>{% endfor %}</div>{% else %}<div class="empty-products"><h2>No Products Available</h2><a class="btn btn-dark rounded-pill" href="{{ '/en/products/' | url }}">Browse All Products</a></div>{% endif %}</section>
