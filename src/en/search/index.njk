<section class="py-5"><div class="container"><div class="text-center mb-5"><h1 class="fw-bold">Search Products</h1><p class="text-muted">Search by product name, description or category.</p></div><div class="row justify-content-center mb-5"><div class="col-lg-8"><div class="input-group input-group-lg"><input type="text" id="productSearchInput" class="form-control" placeholder="Search for a product..."><button class="btn btn-dark px-4" type="button" onclick="filterProducts()">Search</button></div></div></div><div class="row g-4" id="productsGrid">{% for product in products %}{% if product.is_active != false %}<div class="col-md-6 col-lg-4 product-list-item">{% include "components/product-card.njk" %}</div>{% endif %}{% endfor %}</div><div class="text-center py-5 d-none" id="noProductsFound"><h4 class="fw-bold">No Products Found</h4><p class="text-muted">Try another search term.</p></div></div></section>
