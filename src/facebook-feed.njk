---
permalink: "/facebook-feed.xml"
eleventyExcludeFromCollections: true
---
<rss version="2.0" xmlns:g="http://base.google.com/ns/1.0">
<channel>
<title>Nestica Outdoor Furniture</title>
<link>https://nestica-outdoor.com</link>
<description>Outdoor furniture products, offers and prices from Nestica</description>
{% for product in products %}
{% if product.is_active != false %}
<item>
<g:id>{{ product.id }}</g:id>
<g:title><![CDATA[{{ product.feed_title or product.catalog_title or product.name }}]]></g:title>
<g:description><![CDATA[{{ product.description_ar or product.description or product.name }}]]></g:description>
<g:link>https://nestica-outdoor.com/products/{{ product.slug }}/</g:link>
<g:image_link>https://nestica-outdoor.com{{ product.main_image }}</g:image_link>
<g:availability>{% if product.feed_availability %}{{ product.feed_availability }}{% elif product.is_ready %}in stock{% else %}available for order{% endif %}</g:availability>
<g:condition>new</g:condition>
{% if product.is_offer and product.old_price and product.old_price > product.price %}<g:price>{{ product.old_price }} EGP</g:price>
<g:sale_price>{{ product.price }} EGP</g:sale_price>{% else %}<g:price>{{ product.price }} EGP</g:price>{% endif %}
<g:brand>Nestica</g:brand>
</item>
{% endif %}
{% endfor %}
</channel>
</rss>