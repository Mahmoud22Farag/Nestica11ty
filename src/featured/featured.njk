---
pagination:
  data: featuredCollections
  size: 1
  alias: collection
permalink: "/featured/{{ collection.slug }}/"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ collection.name_ar }}"
  description: "{{ collection.description_ar }}"
---
{% set filteredProducts = products | collectionProducts(collection.slug) %}
<section class="catalog-hero compact-hero"><div class="container text-center"><span class="section-kicker">Featured Collection</span><h1>{{ collection.name_ar }}</h1><p>{{ collection.description_ar }}</p></div></section>
<section class="container section-space">{% if filteredProducts.length %}<div class="row g-4">{% for product in filteredProducts %}<div class="col-xl-3 col-lg-4 col-md-6">{% include "components/product-card.njk" %}</div>{% endfor %}</div>{% else %}<div class="empty-products"><h2>لا توجد منتجات حاليًا</h2><a class="btn btn-dark rounded-pill" href="{{ '/products/' | url }}">تصفح كل المنتجات</a></div>{% endif %}</section>
