---
pagination:
  data: categories
  size: 1
  alias: category
permalink: "/categories/{{ category.slug }}/"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ category.seo_title }}"
  description: "{{ category.meta_description }}"
  image: "{{ category.image }}"
  alternateEnPath: "/en/categories/{{ category.slug_en }}/"
---
{% set categoryProducts = products | inCategory(category.id) %}

<nav aria-label="مسار الصفحة" class="container breadcrumb-wrap"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="{{ '/' | url }}">الرئيسية</a></li><li class="breadcrumb-item"><a href="{{ '/products/' | url }}">المنتجات</a></li><li class="breadcrumb-item active" aria-current="page">{{ category.name_ar }}</li></ol></nav>

<section class="category-hero">
  <div class="container"><div class="row align-items-center g-5">
    <div class="col-lg-7"><span class="section-kicker">{{ category.name_en }}</span><h1>{{ category.name_ar }}</h1><p>{{ category.intro }}</p><div class="category-hero-actions"><a href="#category-products" class="btn btn-dark rounded-pill">شوف {{ categoryProducts.length }} منتج</a><a href="https://wa.me/{{ settings.whatsapp | replace('+','') }}?text={{ ('عاوز مساعدة في اختيار ' + category.name_ar) | urlencode }}" target="_blank" rel="noopener" class="btn btn-outline-success rounded-pill" onclick="trackWhatsappLead('category_help')"><i class="bi bi-whatsapp"></i> اسأل عن الأنسب</a></div></div>
    <div class="col-lg-5"><img class="category-hero-img" src="{{ category.image | url }}" alt="{{ category.name_ar }} في مصر من نستيكا" width="{{ category.image_width }}" height="{{ category.image_height }}" loading="eager" fetchpriority="high" decoding="async"></div>
  </div></div>
</section>

{% if category.highlights.length %}<section class="category-highlights"><div class="container"><div class="row g-3">{% for item in category.highlights %}<div class="col-md"><div><i class="bi bi-check2-circle"></i><span>{{ item }}</span></div></div>{% endfor %}</div></div></section>{% endif %}

<section class="container section-space" id="category-products">
  <div class="section-heading d-flex flex-wrap justify-content-between align-items-end gap-3"><div><span class="section-kicker">الموديلات المتاحة</span><h2>{{ category.name_ar }}</h2><p>راجع الصور والمواصفات والسعر الأساسي لكل منتج.</p></div><div class="category-search"><i class="bi bi-search"></i><input type="search" id="productSearchInput" class="form-control" placeholder="ابحث داخل القسم..."></div></div>
  <div class="row g-4" id="productsGrid">{% for product in categoryProducts %}<div class="col-xl-3 col-lg-4 col-md-6 product-list-item">{% include "components/product-card.njk" %}</div>{% endfor %}</div>
  <div class="empty-products d-none" id="noProductsFound"><h2>لا توجد نتائج مطابقة</h2><p>جرّب كلمة بحث مختلفة.</p></div>
</section>

<section class="category-guide section-space"><div class="container"><div class="row g-5 align-items-start"><div class="col-lg-5"><span class="section-kicker">دليل الاختيار</span><h2>{{ category.guide_title }}</h2><p>{{ category.intro }}</p><a href="{{ '/guides/' | url }}" class="btn btn-outline-dark rounded-pill">اقرأ أدلة نستيكا</a></div><div class="col-lg-7"><div class="guide-points">{% for paragraph in category.guide_paragraphs %}<div><span>{{ loop.index }}</span><p>{{ paragraph }}</p></div>{% endfor %}</div></div></div></div></section>

{% if category.faqs.length %}<section class="container section-space faq-section"><div class="section-heading text-center"><span class="section-kicker">أسئلة شائعة</span><h2>أسئلة عن {{ category.name_ar }}</h2></div><div class="accordion faq-accordion" id="categoryFaq">{% for faq in category.faqs %}<div class="accordion-item"><h3 class="accordion-header"><button class="accordion-button {% if not loop.first %}collapsed{% endif %}" type="button" data-bs-toggle="collapse" data-bs-target="#cat-faq-{{ loop.index }}">{{ faq.q }}</button></h3><div id="cat-faq-{{ loop.index }}" class="accordion-collapse collapse {% if loop.first %}show{% endif %}" data-bs-parent="#categoryFaq"><div class="accordion-body">{{ faq.a }}</div></div></div>{% endfor %}</div></section>{% endif %}

<script type="application/ld+json">
{"@context":"https://schema.org","@graph":[
{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"الرئيسية","item":"{{ settings.siteUrl }}/"},{"@type":"ListItem","position":2,"name":"المنتجات","item":"{{ settings.siteUrl }}/products/"},{"@type":"ListItem","position":3,"name":"{{ category.name_ar | jsonLdSafe }}","item":"{{ settings.siteUrl }}/categories/{{ category.slug }}/"}]},
{"@type":"ItemList","name":"{{ category.name_ar | jsonLdSafe }}","numberOfItems":{{ categoryProducts.length }},"itemListElement":[{% for product in categoryProducts %}{"@type":"ListItem","position":{{ loop.index }},"url":"{{ settings.siteUrl }}/products/{{ product.slug }}/","name":"{{ product.name | jsonLdSafe }}"}{% if not loop.last %},{% endif %}{% endfor %}]}
]}
</script>
