---
permalink: /google-merchant-feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:g="http://base.google.com/ns/1.0">
<channel>
<title>{{ settings.brand }} Product Feed</title>
<link>{{ settings.siteUrl }}</link>
<description>Outdoor furniture products from Nestica</description>
{% for product in products %}{% if product.is_active != false %}
<item>
<g:id>{{ product.sku }}</g:id>
<g:title><![CDATA[{{ product.name }}]]></g:title>
<g:description><![CDATA[{{ product.seo_description or product.description_ar }}]]></g:description>
<g:link>{{ settings.siteUrl }}/products/{{ product.slug }}/</g:link>
<g:image_link>{{ settings.siteUrl }}{{ product.main_image }}</g:image_link>
<g:availability>{% if product.feed_availability %}{{ product.feed_availability }}{% elif product.is_ready %}in_stock{% else %}backorder{% endif %}</g:availability>{% if not product.feed_availability and not product.is_ready %}
<g:availability_date>{{ settings.leadTimeMaxDays | daysFromNow('feed') }}</g:availability_date>{% endif %}
<g:price>{{ product.price }} EGP</g:price>
<g:brand>{{ settings.brand }}</g:brand>
<g:condition>new</g:condition>
<g:product_type><![CDATA[Outdoor Furniture > {{ product.category_name }}]]></g:product_type>
<g:identifier_exists>no</g:identifier_exists>
</item>
{% endif %}{% endfor %}
</channel>
</rss>
