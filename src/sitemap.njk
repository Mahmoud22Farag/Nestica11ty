---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {% set staticPaths = ['/', '/products/', '/offers/', '/real-deliveries/', '/guides/', '/about/', '/materials/', '/shipping-delivery/', '/warranty/', '/returns/', '/contact/'] %}
  {% for path in staticPaths %}
  {% set enPath = path | localeUrl('en') %}
  <url><loc>{{ settings.siteUrl }}{{ path }}</loc><xhtml:link rel="alternate" hreflang="ar-EG" href="{{ settings.siteUrl }}{{ path }}"/><xhtml:link rel="alternate" hreflang="en-EG" href="{{ settings.siteUrl }}{{ enPath }}"/><changefreq>{% if path == '/' or path == '/products/' or path == '/offers/' %}weekly{% else %}monthly{% endif %}</changefreq><priority>{% if path == '/' %}1.0{% elif path == '/products/' or path == '/real-deliveries/' %}0.9{% else %}0.7{% endif %}</priority></url>
  <url><loc>{{ settings.siteUrl }}{{ enPath }}</loc><xhtml:link rel="alternate" hreflang="ar-EG" href="{{ settings.siteUrl }}{{ path }}"/><xhtml:link rel="alternate" hreflang="en-EG" href="{{ settings.siteUrl }}{{ enPath }}"/><changefreq>{% if path == '/' or path == '/products/' or path == '/offers/' %}weekly{% else %}monthly{% endif %}</changefreq><priority>{% if path == '/' %}1.0{% elif path == '/products/' or path == '/real-deliveries/' %}0.9{% else %}0.7{% endif %}</priority></url>
  {% endfor %}
  {% for product in products %}{% if product.is_active != false %}
  <url><loc>{{ settings.siteUrl }}/products/{{ product.slug }}/</loc><xhtml:link rel="alternate" hreflang="ar-EG" href="{{ settings.siteUrl }}/products/{{ product.slug }}/"/><xhtml:link rel="alternate" hreflang="en-EG" href="{{ settings.siteUrl }}/en/products/{{ product.slug_en }}/"/><changefreq>monthly</changefreq><priority>0.8</priority></url>
  <url><loc>{{ settings.siteUrl }}/en/products/{{ product.slug_en }}/</loc><xhtml:link rel="alternate" hreflang="ar-EG" href="{{ settings.siteUrl }}/products/{{ product.slug }}/"/><xhtml:link rel="alternate" hreflang="en-EG" href="{{ settings.siteUrl }}/en/products/{{ product.slug_en }}/"/><changefreq>monthly</changefreq><priority>0.8</priority></url>
  {% endif %}{% endfor %}
  {% for category in categories %}{% if category.is_active != false %}
  <url><loc>{{ settings.siteUrl }}/categories/{{ category.slug }}/</loc><xhtml:link rel="alternate" hreflang="ar-EG" href="{{ settings.siteUrl }}/categories/{{ category.slug }}/"/><xhtml:link rel="alternate" hreflang="en-EG" href="{{ settings.siteUrl }}/en/categories/{{ category.slug_en }}/"/><changefreq>weekly</changefreq><priority>0.8</priority></url>
  <url><loc>{{ settings.siteUrl }}/en/categories/{{ category.slug_en }}/</loc><xhtml:link rel="alternate" hreflang="ar-EG" href="{{ settings.siteUrl }}/categories/{{ category.slug }}/"/><xhtml:link rel="alternate" hreflang="en-EG" href="{{ settings.siteUrl }}/en/categories/{{ category.slug_en }}/"/><changefreq>weekly</changefreq><priority>0.8</priority></url>
  {% endif %}{% endfor %}
  {% for space in spaces %}
  <url><loc>{{ settings.siteUrl }}/spaces/{{ space.slug }}/</loc><xhtml:link rel="alternate" hreflang="ar-EG" href="{{ settings.siteUrl }}/spaces/{{ space.slug }}/"/><xhtml:link rel="alternate" hreflang="en-EG" href="{{ settings.siteUrl }}/en/spaces/{{ space.slug }}/"/><changefreq>weekly</changefreq><priority>0.7</priority></url>
  <url><loc>{{ settings.siteUrl }}/en/spaces/{{ space.slug }}/</loc><xhtml:link rel="alternate" hreflang="ar-EG" href="{{ settings.siteUrl }}/spaces/{{ space.slug }}/"/><xhtml:link rel="alternate" hreflang="en-EG" href="{{ settings.siteUrl }}/en/spaces/{{ space.slug }}/"/><changefreq>weekly</changefreq><priority>0.7</priority></url>
  {% endfor %}
  {% for collection in featuredCollections %}<url><loc>{{ settings.siteUrl }}/featured/{{ collection.slug }}/</loc><changefreq>weekly</changefreq><priority>0.6</priority></url><url><loc>{{ settings.siteUrl }}/en/featured/{{ collection.slug }}/</loc><changefreq>weekly</changefreq><priority>0.6</priority></url>{% endfor %}
  {% for guide in guides %}<url><loc>{{ settings.siteUrl }}/guides/{{ guide.slug }}/</loc><xhtml:link rel="alternate" hreflang="ar-EG" href="{{ settings.siteUrl }}/guides/{{ guide.slug }}/"/><xhtml:link rel="alternate" hreflang="en-EG" href="{{ settings.siteUrl }}/en/guides/{{ guide.slug }}/"/><changefreq>yearly</changefreq><priority>0.7</priority></url><url><loc>{{ settings.siteUrl }}/en/guides/{{ guide.slug }}/</loc><xhtml:link rel="alternate" hreflang="ar-EG" href="{{ settings.siteUrl }}/guides/{{ guide.slug }}/"/><xhtml:link rel="alternate" hreflang="en-EG" href="{{ settings.siteUrl }}/en/guides/{{ guide.slug }}/"/><changefreq>yearly</changefreq><priority>0.7</priority></url>{% endfor %}
</urlset>
